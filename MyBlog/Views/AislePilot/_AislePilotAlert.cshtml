@model AislePilotAlertViewModel
@{
    var (alertTitle, alertGuidance) = Model.Category switch
    {
        AislePilotAlertCategory.Constraint => ("Your preferences need a small change", "Follow the links below, adjust one preference, then try again."),
        AislePilotAlertCategory.Operation => ("We could not complete that action", "Your settings are safe. Review the message below and try again."),
        _ => ("Check the highlighted settings", "Follow each link to the field that needs attention, then try again.")
    };
}
<section aria-labelledby="aislepilot-alert-title" class="aislepilot-shell aislepilot-alert-shell" role="alert" data-validation-summary data-reveal>
    <h2 id="aislepilot-alert-title" class="aislepilot-section-title">@alertTitle</h2>
    <p class="aislepilot-alert-guidance">@alertGuidance</p>
    <ul class="aislepilot-alert-list">
        @foreach (var error in Model.Items.Take(5))
        {
            <li>
                @if (!string.IsNullOrWhiteSpace(error.TargetId))
                {
                    <a href="#@error.TargetId">@(error.FieldLabel is null ? error.Message : $"{error.FieldLabel}: {error.Message}")</a>
                }
                else
                {
                    @error.Message
                }
            </li>
        }
    </ul>
    <div class="aislepilot-alert-actions">
        <button type="submit"
                class="aislepilot-alert-btn"
                form="aislepilot-setup-form"
                data-loading-label="Generating plan..."
                data-show-plan-skeleton>
            Generate again
        </button>
        @if (Model.HasResult)
        {
            <button type="button"
                    class="aislepilot-alert-btn is-secondary"
                    data-setup-toggle
                    aria-controls="aislepilot-setup"
                    aria-expanded="false">
                Edit settings
            </button>
        }
        else
        {
            <a href="#aislepilot-setup" class="aislepilot-alert-btn is-secondary">Review settings</a>
        }
    </div>
</section>
