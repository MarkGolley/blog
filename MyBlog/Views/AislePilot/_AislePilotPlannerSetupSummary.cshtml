@model AislePilotPlannerSetupSummaryViewModel
<p class="aislepilot-setup-summary-kicker">Your weekly plan</p>
<h3 id="aislepilot-setup-summary-title" class="aislepilot-setup-summary-title">Your selections</h3>
<p class="aislepilot-setup-summary-copy">Review the week, recipes and shopping list AislePilot will prepare.</p>
<dl class="aislepilot-setup-summary-list">
    <div class="aislepilot-setup-summary-item">
        <dt>Cooking for</dt>
        <dd data-serving-summary>@Model.ServingSummaryText</dd>
    </div>
    <div class="aislepilot-setup-summary-item">
        <dt>Dietary</dt>
        <dd data-dietary-summary>@Model.DietarySummaryText</dd>
    </div>
    <div class="aislepilot-setup-summary-item">
        <dt>Store</dt>
        <dd data-plan-basic-mirror="supermarket">@Model.SelectedSupermarketLabel</dd>
    </div>
    <div class="aislepilot-setup-summary-item">
        <dt>Meal slots</dt>
        <dd data-plan-basic-mirror="meal-types">@Model.MealTypesSummaryText</dd>
    </div>
    <div class="aislepilot-setup-summary-item">
        <dt>Number of days</dt>
        <dd data-plan-basic-mirror="plan-days">@Model.PlanLengthText</dd>
    </div>
    <div class="aislepilot-setup-summary-item">
        <dt>Budget</dt>
        <dd data-plan-basic-mirror="budget">@Model.BudgetText</dd>
    </div>
    <div class="aislepilot-setup-summary-item">
        <dt>Extras</dt>
        <dd data-special-options-summary>@Model.SpecialOptionsSummaryText</dd>
    </div>
</dl>
<p class="aislepilot-setup-summary-note">Generate the plan when the budget, meal cadence, and extras look right.</p>
