@model System.ValueTuple<string, bool, bool>
@{
    var safeDayName = string.IsNullOrWhiteSpace(Model.Item1) ? "day" : Model.Item1.Trim();
    var earlierDisabled = Model.Item2 ? null : "disabled";
    var laterDisabled = Model.Item3 ? null : "disabled";
}

<button type="button"
        class="aislepilot-day-card-reorder-handle"
        data-day-reorder-handle
        aria-label="@($"Drag {safeDayName} menu to another day")"
        title="@($"Drag {safeDayName} menu")">
    <span class="aislepilot-day-card-reorder-handle-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="8" cy="7" r="1.6"></circle>
            <circle cx="16" cy="7" r="1.6"></circle>
            <circle cx="8" cy="12" r="1.6"></circle>
            <circle cx="16" cy="12" r="1.6"></circle>
            <circle cx="8" cy="17" r="1.6"></circle>
            <circle cx="16" cy="17" r="1.6"></circle>
        </svg>
    </span>
    <span class="aislepilot-day-card-reorder-handle-label" aria-hidden="true">Drag menu</span>
    <span class="sr-only">Drag @safeDayName menu to another day</span>
</button>
<div class="aislepilot-day-reorder-move-actions" role="group" aria-label="Move @safeDayName">
    <button type="button" class="aislepilot-day-reorder-move" data-day-reorder-move="earlier" aria-label="Move @safeDayName menu earlier" @earlierDisabled><span aria-hidden="true">↑</span> Earlier</button>
    <button type="button" class="aislepilot-day-reorder-move" data-day-reorder-move="later" aria-label="Move @safeDayName menu later" @laterDisabled>Later <span aria-hidden="true">↓</span></button>
</div>
