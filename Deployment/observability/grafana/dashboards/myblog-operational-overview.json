      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - (sum(increase({__name__=~\"myblog_http_request_duration.*_count\",service_name=~\"$service\",status_code=~\"5..\"}[30d])) / clamp_min(sum(increase({__name__=~\"myblog_http_request_duration.*_count\",service_name=~\"$service\"}[30d])), 1)))"
