    {
      "id": 20,
      "title": "AislePilot Replenishment by Request Profile (30m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 52 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (dietary_complexity, meal_slot_count, plan_length, prefer_quick_meals, include_special_treat, success) (increase({__name__=~\"myblog_aislepilot_background_jobs.*\",service_name=~\"$service\",job=\"plan_pool_replenishment\"}[30m]))",
          "legendFormat": "{{dietary_complexity}} / {{meal_slot_count}} slots / {{plan_length}} / quick={{prefer_quick_meals}} / treat={{include_special_treat}} / success={{success}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 21,
      "title": "AislePilot Plan Sources (30m)",
      "type": "timeseries",
