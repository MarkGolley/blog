    {
      "id": 17,
      "title": "AislePilot User Journey Funnel (30m)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 38
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase({__name__=~\"myblog_http_request_duration.*_count\",service_name=~\"$service\",endpoint=~\"MyBlog.Controllers.AislePilotController.Index \\\\(MyBlog\\\\)\",method=\"GET\",status_code=~\"2..\"}[30m]))",
          "legendFormat": "1) Planner Views"
        },
        {
          "refId": "B",
          "expr": "sum(increase({__name__=~\"myblog_http_request_duration.*_count\",service_name=~\"$service\",endpoint=~\"MyBlog.Controllers.AislePilotController.Index \\\\(MyBlog\\\\)\",method=\"POST\",status_code=~\"2..\"}[30m]))",
          "legendFormat": "2) Plan Generations"
        },
        {
          "refId": "C",
          "expr": "sum(increase({__name__=~\"myblog_http_request_duration.*_count\",service_name=~\"$service\",endpoint=~\"MyBlog.Controllers.AislePilotController.SwapMeal \\\\(MyBlog\\\\)\",method=\"POST\",status_code=~\"2..\"}[30m]))",
          "legendFormat": "3) Meal Swaps"
        },
        {
          "refId": "D",
          "expr": "sum(increase({__name__=~\"myblog_http_request_duration.*_count\",service_name=~\"$service\",endpoint=~\"MyBlog.Controllers.AislePilotController.Export(PlanPack|Checklist) \\\\(MyBlog\\\\)\",method=\"POST\",status_code=~\"2..\"}[30m]))",
          "legendFormat": "4) Exports"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      }
    },
    {
